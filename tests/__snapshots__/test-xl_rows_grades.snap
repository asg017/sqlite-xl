Source: ../test.sql
select
  xl_at(row, 'A') as student_id,
  xl_at(row, 'B') as assignment_id,
  xl_at(row, 'C') as score,
  xl_at(row, 'D') as submitted
from xl_rows(readfile('tests/students.xlsx'), 'grades')
where row_number > 1
limit 5;
