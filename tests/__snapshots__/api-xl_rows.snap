Source: ../api.sql
select
  rowid,
  row_number,
  row,
  row ->> 'A',
  row ->> 'B',
  row ->> 'C',
  row ->> 'D',
  row ->> 'E',
  row ->> 'F'
from xl_rows(readfile('tests/file-sample.xlsx'))
limit 6;
---
{
	 rowid: 0
	 row_number: 1
	 row: pointer[]
	 row ->> 'A': 'number'
	 row ->> 'B': 'decimal'
	 row ->> 'C': 'date'
	 row ->> 'D': 'boolean'
	 row ->> 'E': 'text'
	 row ->> 'F': NULL
}
{
	 rowid: 1
	 row_number: 2
	 row: pointer[]
	 row ->> 'A': 1.0
	 row ->> 'B': 1.1
	 row ->> 'C': '2000-01-01'
	 row ->> 'D': 1
	 row ->> 'E': 'CONTROL ROW'
	 row ->> 'F': NULL
}
