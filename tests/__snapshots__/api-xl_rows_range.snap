Source: ../api.sql
select
  xl_at(row, 'A') as student_id,
  xl_at(row, 'D') as submitted,
  xl_at(row, 'E') as time_spent
from xl_rows(readfile('tests/students.xlsx'), 'grades!A2:E4')
limit 5;
